rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The app only ever reads/writes documents at draws/{gameId}.
    // Anyone with the site link can read or write (there is no real
    // Firebase Auth here — the app's own access-code screen is the only
    // gate, same as before). These rules just stop garbage/oversized
    // writes and block every other path in the database.
    match /draws/{gameId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['state', 'updatedAt'])
                   && request.resource.data.state is string
                   && request.resource.data.state.size() < 200000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
